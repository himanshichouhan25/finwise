# FinWise AI - Environment Variables Configuration
# Copy this file to .env or backend/.env and fill in real values.
# NEVER commit real API keys or secrets to Git.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection (SQLite for Hackathon MVP)
DATABASE_URL=sqlite:///./finwise.db

# AI / LLM Configuration (Groq API)
# The backend boots gracefully without this key; AI endpoints will return AI_UNAVAILABLE.
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# FINWISE AI — MARKET DATA CONFIGURATION
# ==========================================

# Primary Market Data Provider (tapetide | bharatstock | alphavantage | demo)
MARKET_DATA_PROVIDER=tapetide
TAPETIDE_API_KEY=

# Secondary Provider
BHARATSTOCK_API_KEY=

# Optional Backup Provider
ALPHA_VANTAGE_API_KEY=

# ==========================================
# MARKET DATA SETTINGS
# ==========================================

MARKET_DATA_CACHE_TTL=300
MARKET_DATA_TIMEOUT=15
MARKET_DATA_RETRY_COUNT=2

# ==========================================
# MARKET NEWS
# ==========================================

MARKET_NEWS_PROVIDER=alphavantage

# Frontend Environment Variable (Vite SPA)
# Note: In production or separate client deployment, set this in frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api/v1

